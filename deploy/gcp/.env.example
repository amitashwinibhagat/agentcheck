# Copy to .env and fill in. Never commit .env.

# --- required -----------------------------------------------------------------
# The hostname Caddy serves. Use a domain you control, or for a demo:
#   <your-static-ip-with-dashes>.sslip.io   e.g. 34-12-34-56.sslip.io
SITE_ADDRESS=agentcheck.example.com
# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=you@example.com

# --- non-demo instance (optional) ---------------------------------------------
# A second app container on the same host, with AGENTCHECK_DEMO=0, so it hands
# out no key and is the safe place to arm billing. Leave blank for a
# single-instance deployment (Caddy defaults it to a localhost-only site).
# With no domain, `app.<ip-with-dashes>.sslip.io` resolves to the same host.
SITE_ADDRESS_PROD=

# --- judge --------------------------------------------------------------------
# Omit to run the offline stub judge (nothing leaves the machine).
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# --- demo ---------------------------------------------------------------------
# 1 hands out a capped demo key from any origin. Set 0 for a private install.
AGENTCHECK_DEMO=1

# --- sign-in (optional; leave blank to disable) -------------------------------
# All four are needed together. See README "Sign-in and sessions".
AGENTCHECK_AUTH=
AGENTCHECK_SECRET=
AGENTCHECK_BASE_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# --- database (optional) ------------------------------------------------------
# Set to use Postgres instead of the SQLite file on the volume.
AGENTCHECK_DB_URL=

# --- billing (optional; leave blank to not take money) ------------------------
# AGENTCHECK_BILLING must be set explicitly. Credentials alone never arm the
# payment endpoints: a shared Razorpay account may hold plans for another
# product, and the plan ids below are deliberately per-tier so one product's
# plan can never be billed for another's customers.
#
#   AGENTCHECK_BILLING=razorpay
#   RAZORPAY_KEY_ID=rzp_live_...
#   RAZORPAY_KEY_SECRET=...
#   RAZORPAY_WEBHOOK_SECRET=...        # the secret set on THIS webhook
#   RAZORPAY_PLAN_ID_PRO=plan_...      # create in the Razorpay dashboard
#   RAZORPAY_PLAN_ID_TEAM=plan_...
#
# Then point a Razorpay webhook at https://<SITE_ADDRESS>/v1/billing/webhook
# for the subscription.* and payment.* events. `agentcheck billing` reports
# whether this deployment can actually take money.
AGENTCHECK_BILLING=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_TEAM=
