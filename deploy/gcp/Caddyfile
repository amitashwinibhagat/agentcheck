# Caddy terminates TLS here and proxies to the app.
#
# SITE_ADDRESS and ACME_EMAIL come from the environment (see .env.example),
# so this file is the same for every deployment.
#
# No domain? `34-12-34-56.sslip.io` resolves to 34.12.34.56 for free and Caddy
# will get a real certificate for it. Fine for a demo; use a domain you
# control for anything a customer will see.
{
	email {$ACME_EMAIL}
}

# Shared proxy options. Both sites stream Server-Sent Events, and
# flush_interval -1 disables the response buffering that would otherwise
# deliver live events in clumps or not at all. If this is ever edited on one
# upstream and not the other, streaming breaks on exactly one instance — so it
# lives here, once. (Logs go to stdout on purpose: Caddy's /data volume holds
# certificates, and an access log written there would grow it forever. Docker's
# log rotation bounds it instead.)
(common) {
	encode zstd gzip

	# Security headers, once, for every site.
	#
	# The UI keeps the workspace key in sessionStorage and renders approve /
	# block / remove-member controls, so two things matter here: it must not be
	# framable (clickjacking an operator into approving a call is the attack),
	# and a script injection must not be able to phone anywhere.
	#
	# CSP notes: 'unsafe-inline' is required for styles because the client
	# sets style attributes from data (trust bars, verdict colours); scripts
	# are NOT granted it, so an injected <script> still will not run.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

(proxy-upstream) {
	reverse_proxy {args.0}:7373 {
		flush_interval -1
	}
}

{$SITE_ADDRESS} {
	import common
	import proxy-upstream agentcheck
}

# The non-demo instance. SITE_ADDRESS_PROD defaults to localhost:9999 when
# unset, so a single-instance deployment parses and simply never serves it.
{$SITE_ADDRESS_PROD} {
	import common

	# The distribution wheel, installable by URL. Until PyPI is unblocked
	# (Actions billing) this is how a stranger gets the product:
	#   pip install https://<host>/wheels/<wheel>.whl
	handle_path /wheels/* {
		root * /srv/dist
		file_server
	}

	# The webhook lives here, not on the demo: only this instance can take
	# money.
	import proxy-upstream agentcheck-prod
}
