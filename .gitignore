# Secrets. Never commit a real env file — `deploy/gcp/.env` is the one the
# runbook tells people to create, and it holds the judge key, the WorkOS
# credentials and the session signing secret.
.env
.env.*
*.env
# After the excludes, deliberately: git applies these last-match-wins, so a
# `!.env.example` placed above `.env.*` was itself re-ignored and the template
# never reached the repo -- `cp .env.example .env` then failed on a fresh
# clone. The template holds no secrets; only real env files are kept out.
!.env.example
!**/.env.example
deploy/gcp/.env

# Local database and generated reports
*.db
agentcheck.db
trust-validation.json
calibration.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/

# macOS. AppleDouble files (`._foo.yaml`) matter here specifically: they match
# a `*.yaml` glob but are binary, and reading one used to 500 the rubric list.
.DS_Store
._*
**/._*

# Design scratch, not product. The icons the app actually serves live in
# agentcheck/web/static/icons/ and are committed.
.impeccable/
.review/
icon-output/
output/

# internal-only docs: strategy, margins, battlecard. Public repo, private plan.
/AGENTS.md
/PLAN.md
/MONETIZATION.md
/PRODUCT.md
/REVIEW-FINDINGS.md
/competitive-battlecard.html
/PUBLISH-PLAN.md
